# Cadena de conexión. MongoDB DEBE correr como Replica Set para soportar transacciones.
# Local con docker compose:  mongodb://localhost:27017/?directConnection=true
# MongoDB Atlas:             mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net
MONGO_URI=mongodb://localhost:27017/?directConnection=true
DB_NAME=gym_manager

# Moneda y formato (ISO 4217 / BCP 47)
CURRENCY=COP
LOCALE=es-CO

# Zona horaria usada en reportes (agrupación por día)
TIMEZONE=America/Bogota

# true = muestra el stack trace de errores inesperados
DEBUG=false
