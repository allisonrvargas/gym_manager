{
  "name": "gym-manager-cli",
  "version": "1.0.0",
  "description": "CLI para la gestión integral de clientes, planes de entrenamiento, seguimiento físico, nutrición, contratos y finanzas de un gimnasio.",
  "main": "index.js",
  "type": "module",
  "bin": { "gym-manager": "./index.js" },
  "scripts": {
    "start": "node index.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": { "node": ">=18.0.0" },
  "keywords": ["cli", "gym", "mongodb", "transactions", "solid", "design-patterns"],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "inquirer": "^9.3.7",
    "mongodb": "^6.10.0",
    "ora": "^8.1.1"
  }
}
